# Vorlage für .env — echte Werte gehören niemals ins Repo.
# Kopieren mit: cp .env.example .env

# Öffentliche Adresse, unter der drop hinter dem Proxy erreichbar ist.
# Daraus werden die Redirect-URI, die Raum-Links im QR-Code und der
# erlaubte Origin des WebSocket-Upgrades gebildet.
DROP_PUBLIC_URL=https://drop.kanonenwiese.de

# Adresse, auf der der Container lauscht.
DROP_ADDR=:8080

# Pocket ID. Der Client dort anlegen und als Redirect-URI genau
# ${DROP_PUBLIC_URL}/auth/callback eintragen.
DROP_OIDC_ISSUER=https://id.kanonenwiese.de
DROP_OIDC_CLIENT_ID=
# Nur bei einem vertraulichen Client nötig; mit PKCE und öffentlichem
# Client bleibt das Feld leer.
DROP_OIDC_CLIENT_SECRET=
DROP_OIDC_SCOPES=openid,profile,email

# Hosts, von denen der Server Profilbilder holen darf. Der Host aus
# DROP_OIDC_ISSUER ist immer erlaubt; hier stehen nur zusätzliche, falls der
# Provider die Bilder woanders ablegt. Einträge sind "host" oder "host:port"
# ohne Schema. Diese Liste ist der SSRF-Schutz des Bild-Proxys — je kürzer,
# desto besser.
DROP_AVATAR_HOSTS=

# Schlüssel für das signierte Session-Cookie (mindestens 16 Zeichen).
# Erzeugen mit: openssl rand -base64 32
# Fehlt er, erzeugt drop beim Start einen — dann sind nach jedem Neustart
# alle Anmeldungen weg.
DROP_SESSION_KEY=
DROP_SESSION_TTL=12h

# Hinter dem Nginx Proxy Manager steht die echte Client-IP in
# X-Forwarded-For. Nur mit true zählt dieser Header für das Rate-Limit —
# ohne Proxy davor muss er false bleiben, sonst ist er fälschbar.
DROP_TRUSTED_PROXY=true

# Raum-Lifecycle
DROP_ROOM_EMPTY_GRACE=60s
DROP_ROOM_MAX_AGE=12h
DROP_ROOM_MAX_MEMBERS=16

# Transfer-Limits (Suffixe k/m/g erlaubt)
DROP_MAX_FILE_SIZE=100m
DROP_MAX_CHUNK_SIZE=64k
DROP_MAX_TEXT_ITEM_SIZE=256k
DROP_MAX_LIVE_TEXT_SIZE=64k

# Rate-Limit für Beitrittsversuche pro IP
DROP_JOIN_RATE_PER_MINUTE=10
DROP_JOIN_RATE_BURST=5
